{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sais:mosaic:cue:1",
  "title": "MOSAIC Subject-Visible Evidence Cue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "trial_id",
    "core_id",
    "cue_index",
    "source_label",
    "claim",
    "stated_reliability",
    "quartet_commitment"
  ],
  "properties": {
    "protocol_version": {"const": "SAIS/MOSAIC/CUE/1"},
    "trial_id": {"pattern": "^MOSAIC-P1-[0-9]{3}$"},
    "core_id": {"pattern": "^MOSAIC-CORE-[0-9]{2}$"},
    "cue_index": {"enum": [1, 2]},
    "source_label": {"type": "string", "minLength": 1},
    "claim": {"enum": ["available", "degraded"]},
    "stated_reliability": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1.0},
    "quartet_commitment": {"pattern": "^[a-f0-9]{64}$"}
  }
}
